# ══════════════════════════════════════════════════════════════
#  Polymarket Bot — configuración
#  Copia este archivo a ".env" y rellena tus valores.
#  NUNCA subas el .env real a git (contiene tu private key).
# ══════════════════════════════════════════════════════════════

# ── Credenciales de Polymarket (OBLIGATORIAS para operar en real) ──
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=
# Se derivan solas la primera vez; si el bot te las imprime, pégalas aquí
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ── Modo de operación ──────────────────────────────────────────
# true  = simula órdenes (NO gasta dinero). Empieza SIEMPRE así.
# false = opera con dinero real.
DRY_RUN=true

# Cero llamadas de pago. Si es true, el análisis con IA queda forzado
# a apagado aunque otras variables digan lo contrario.
FREE_ONLY=true

# Sin IA no hace falta. Solo se usa si FREE_ONLY=false.
ANTHROPIC_API_KEY=

# ── Bankroll y riesgo ──────────────────────────────────────────
# Solo se usa la primera vez (después manda agent_state.json)
BANKROLL=20
MIN_BET_USD=2.0
MAX_BET_USD=15.0
MAX_OPEN_BETS=8
MAX_DAILY_LOSS=20
TAKE_PROFIT_PCT=0.30
STOP_LOSS_PCT=0.40

# ── Estrategias (opción B: copytrading + resolución tardía) ─────
SMART_MONEY_ENABLED=true
LATE_RESOLUTION_ENABLED=true
CORRELATED_ARB_ENABLED=false
CONTRARIAN_ENABLED=false

# ── Smart Money copytrading ────────────────────────────────────
# Cada cuánto revisa las wallets (y monitorea posiciones)
SMART_MONEY_INTERVAL_MIN=15
# Antigüedad máxima de un trade para copiarlo
SMART_MONEY_MAX_HOURS=72
SMART_MONEY_MAX_COPIES=2
# % del bankroll por copia (el exchange exige mínimo $5)
SMART_MONEY_BET_PCT=0.03
SMART_MONEY_MAX_SLIPPAGE=0.10
# 1 = copiar cualquier wallet. 2 = solo si 2 wallets distintas
# compraron el mismo token (señal confirmada, menos ruido).
SMART_MONEY_MIN_CONSENSUS=1

# ── Escaneo de mercados ────────────────────────────────────────
SCAN_INTERVAL_MIN=60
# 0 = sin análisis IA (gratis). Ignorado si FREE_ONLY=true.
MAX_MARKETS_PER_RUN=0
MIN_LIQUIDITY=5000
MIN_VOLUME=5000

# ── Keep-alive HTTP (NO necesario bajo systemd) ────────────────
# Déjalo en false en el servidor: evita chocar de puerto con otros bots.
KEEPALIVE_ENABLED=false
KEEPALIVE_HOST=127.0.0.1
PORT=8080
